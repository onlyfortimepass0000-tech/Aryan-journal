# Shared secret that gates the whole app (UI + API). Set this in Vercel project settings.
ACCESS_TOKEN=

# GitHub storage: entries are committed as a JSON file directly into this repo
# (git history is the database) instead of using a hosted database.
#
# GITHUB_TOKEN needs a personal access token (fine-grained, scoped to just this
# repo) with the "Contents" permission set to Read and write.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Optional overrides — defaults shown.
# GITHUB_BASE_BRANCH=main
# DATA_BRANCH=data
# DATA_FILE_PATH=data/entries.json
